NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL bağlantısı (docker-compose.yml ile uyumlu)
DATABASE_URL=postgresql://otpsplash:otpsplash@localhost:5432/otpsplash?schema=public

# JWT — iki secret FARKLI olmalı, min 32 karakter
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OTP şifreleme — 64 hex karakter (32 byte)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_ENCRYPTION_KEY=
OTP_TTL_DAYS=7

# Device Secret uzunluğu (byte) — 32 = 256-bit
DEVICE_SECRET_BYTES=32

# CORS origin (cors middleware + Socket.IO) — yerel ağ/mobil testte '*' (wildcard)
# bırakılabilir, production'da gerçek origin ile değiştirilir.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
