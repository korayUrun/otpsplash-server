generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(512)
  role      Role
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([projectId])
  @@map("users")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  apiKey    String   @unique @default(uuid()) @db.Uuid
  users     User[]
  otpLogs   OTPLog[]
  devices   Device[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  secretHash String    @db.VarChar(512) // argon2id hash — plain secret asla saklanmaz
  platform   Platform
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String    @db.Uuid
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isRevoked  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  otpLogs    OTPLog[]

  @@index([userId])
  @@index([projectId])
  @@map("devices")
}

model OTPLog {
  id            String   @id @default(uuid()) @db.Uuid
  encryptedCode String   @db.VarChar(512) // iv:authTag:ciphertext (base64)
  source        Source
  projectId     String   @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deviceId      String?  @db.Uuid // hangi cihazdan geldi — izleme/analiz için
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([projectId])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("otp_logs")
}

enum Role {
  RECEIVER
  DEVELOPER
  ADMIN
}

enum Source {
  ANDROID
  IOS_SHORTCUT
}

enum Platform {
  ANDROID
  IOS
}
