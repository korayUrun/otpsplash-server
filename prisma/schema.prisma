generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  name         String?       @db.VarChar(100) // görünen ad; opsiyonel — admin panelinde email yerine gösterilir
  phoneNumber  String?       @db.VarChar(32) // hesap iletişim numarası; self-register'da beyan edilir, opsiyonel
  password     String        @db.VarChar(512)
  role         Role
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices      Device[]
  groupMembers GroupMember[]
  routingRules RoutingRule[]  @relation("ReceiverRules")
  receivedOtps OTPLog[]       @relation("ReceiverOtps") // sahiplik kanıtı — deviceId'den bağımsız
  dismissals   OtpDismissal[] @relation("DeveloperDismissals") // developer'ın kendi feed'inden kaldırdığı OTP'ler
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([projectId])
  @@map("users")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  apiKey    String   @unique @default(uuid()) @db.Uuid
  isDefault Boolean  @default(false) // self-register bu projeye bağlanır; en fazla bir tane (partial unique index)
  users     User[]
  otpLogs   OTPLog[]
  devices   Device[]
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

// NOT: self-register her yeni kullanıcıyı `isDefault: true` olan projeye bağlar. Aynı anda
// yalnızca BİR varsayılan proje olmalı — bu, migration'a elle eklenen partial unique index ile
// DB seviyesinde garanti edilir (schema.prisma'da ifade edilemez):
//
//   CREATE UNIQUE INDEX "projects_isDefault_key" ON "projects" ("isDefault") WHERE "isDefault" = true;

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  secretHash  String    @db.VarChar(512) // argon2id hash — plain secret asla saklanmaz
  platform    Platform
  deviceName  String?   @db.VarChar(100) // receiver kayıt sırasında girer, opsiyonel ("İş Telefonum")
  phoneNumber String?   @db.VarChar(32) // receiver beyanı, opsiyonel — SMS'ten OTOMATİK türetilmez
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  isRevoked   Boolean   @default(false)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  otpLogs     OTPLog[]

  @@index([userId])
  @@index([projectId])
  @@map("devices")
}

model Group {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(100) // admin tarafından konur, receiver'a görünür
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  routingRules RoutingRule[] @relation("GroupRules")
  createdAt    DateTime      @default(now())

  @@index([projectId])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid // DEVELOPER rolünde bir User
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// Hangi receiver'ın kodu kime (developer veya grup) gidecek.
// Servis kavramı kaldırıldı — kural artık yalnızca receiver → hedef ikilisine bağlıdır.
model RoutingRule {
  id          String        @id @default(uuid()) @db.Uuid
  receiverId  String        @db.Uuid
  receiver    User          @relation("ReceiverRules", fields: [receiverId], references: [id], onDelete: Cascade)
  targetType  RoutingTarget // DEVELOPER | GROUP
  developerId String?       @db.Uuid // targetType=DEVELOPER ise dolu
  groupId     String?       @db.Uuid // targetType=GROUP ise dolu
  group       Group?        @relation("GroupRules", fields: [groupId], references: [id], onDelete: Cascade)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([receiverId])
  @@map("routing_rules")
}

// NOT: PostgreSQL'de düz @@unique([...]) NULL'ları "farklı" sayar — targetType=DEVELOPER
// kayıtlarında groupId hep NULL olduğundan aynı (receiver, developer) tekrar eklenebilirdi.
// Bu yüzden migration'da @@unique yerine İKİ AYRI partial unique index raw SQL ile eklenir
// (migration dosyasına elle eklendi). schema.prisma'da ifade edilemez:
//
//   CREATE UNIQUE INDEX routing_rule_developer_unique
//     ON routing_rules (receiver_id, developer_id)
//     WHERE target_type = 'DEVELOPER';
//   CREATE UNIQUE INDEX routing_rule_group_unique
//     ON routing_rules (receiver_id, group_id)
//     WHERE target_type = 'GROUP';
//
// Bu DB seviyesi koruma, routing.service.ts'teki createRule'da yapılan açık "zaten var mı"
// kontrolünün YERİNE değil, ONUN YANINDA çalışır — çift katmanlı korunur.

// OTP kodları SÜRESİZDİR — expiresAt yoktur, otomatik silme (cron) yoktur.
// Developer istediğinde kendi feed'inden OtpDismissal ile kaldırır (kalıcı silme değil).
model OTPLog {
  id            String         @id @default(uuid()) @db.Uuid
  encryptedCode String         @db.VarChar(512) // iv:authTag:ciphertext (base64)
  source        Source
  projectId     String         @db.Uuid
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deviceId      String?        @db.Uuid // izleme/analiz amaçlı — onDelete: SetNull
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  receiverId    String         @db.Uuid // SAHİPLİK KAYNAĞI — deviceId silinse bile kalıcı
  receiver      User           @relation("ReceiverOtps", fields: [receiverId], references: [id], onDelete: Cascade)
  senderRaw     String?        @db.VarChar(255) // ham gönderici kimliği — developer'a gösterilecek etiket. SMS GÖVDESİ DEĞİL, yalnızca gönderici.
  context       String?        @db.VarChar(120) // opsiyonel serbest metin bağlam etiketi (cihazdan gelir; gelmezse null)
  sharingActive Boolean        @default(true) // receiver bu OTP'nin paylaşımını durdurabilir
  dismissals    OtpDismissal[] // developer'ların kendi feed'inden kaldırdığı işaretler
  createdAt     DateTime       @default(now())

  @@index([projectId])
  @@index([deviceId])
  @@index([receiverId])
  @@map("otp_logs")
}

// Developer bir OTP'yi KENDİ feed'inden kaldırdığında oluşur (per-developer, yumuşak gizleme).
// Kalıcı silme DEĞİLDİR: OTP tabloda kalır — receiver kendi geçmişinde, admin özet ekranında
// görmeye devam eder; sadece bu developer'ın history'sinden düşer. Aynı OTP grup üzerinden
// başka developer'lara gittiyse onları etkilemez.
model OtpDismissal {
  id        String   @id @default(uuid()) @db.Uuid
  otpId     String   @db.Uuid
  otp       OTPLog   @relation(fields: [otpId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid // kaldıran DEVELOPER
  user      User     @relation("DeveloperDismissals", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([otpId, userId]) // aynı OTP bir developer için iki kez kaldırılamaz
  @@index([userId])
  @@map("otp_dismissals")
}

enum Role {
  RECEIVER
  DEVELOPER
  ADMIN
}

enum Source {
  ANDROID
  IOS_SHORTCUT
}

enum Platform {
  ANDROID
  IOS
}

enum RoutingTarget {
  DEVELOPER
  GROUP
}
